<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bar_bg"
        android:theme="@style/ThemeOverlay.Material3.Dark"
        app:menu="@menu/main_menu"
        app:title="@string/app_name"
        app:titleTextColor="@color/terminal_fg" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/status_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="@string/status_idle"
        android:textColor="@color/status_fg"
        android:textSize="12sp" />

    <ai.opencode.cli.terminal.TerminalView
        android:id="@+id/terminal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/terminal_bg" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar_bg"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/key_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp" />
    </HorizontalScrollView>
</LinearLayout>
